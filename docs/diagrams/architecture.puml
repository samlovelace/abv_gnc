@startuml architecture
skinparam backgroundColor transparent
skinparam componentStyle rectangle
skinparam defaultTextAlignment center
skinparam wrapWidth 200
skinparam component {
  BackgroundColor #f5f7fa
  BorderColor #4a5a70
  FontSize 13
}
skinparam package {
  BackgroundColor #eef2f7
  BorderColor #4a5a70
  FontSize 13
}
skinparam arrow {
  FontSize 11
}

package "Human operator (laptop)" as human_pkg {
  component "autobot_gui\nautobot_commander\nautobot_teleop" as human
}

package "External autonomy module" as auto_pkg {
  component "ptera_msgs\nwaypoints / state" as autonomy
}

package "On board the ABV" as onboard {
  component "autobot_bridge" as bridge
  component "autobot_guidance\n(line / file / avoid)" as gdnc
  component "autobot_navigation\n(EKF)" as nav
  component "autobot_goal_manager" as gm
  component "autobot_control\n(PID)" as ctrl
  component "autobot_rl-cpp\n(RL, ONNX)" as rl
  component "autobot_policy_registry" as reg
  component "autobot_thrusters" as thr
}

component "Thruster hardware\n(or autobot_simulator)" as hw

human -down-> gdnc : abv/guidance/command\nabv/scene/obstacles
human -down-> gm : abv/controller/command
human -down-> reg : abv/policy/switch

autonomy <.right.> bridge : ptera_msgs
bridge -down-> gdnc : abv/guidance/command

gdnc -down-> gm : abv/controller/command
gm -up-> gdnc : abv/controller/status
gm -down-> ctrl : abv/controller/context
gm -down-> rl : abv/controller/context
reg .down.> ctrl : abv/policy/active
reg .down.> rl : abv/policy/active
reg .down.> thr : abv/policy/active
ctrl -down-> thr : abv/thrusters/command
rl -down-> thr : abv/thrusters/command
gm -down-> thr : direct commands

thr -down-> hw : thruster firings
thr -up-> nav : abv/thrusters/status
nav -up-> gdnc : abv/state

@enduml
