<mujoco model="tabletop_scene">

    <compiler angle="radian"/>

    <option gravity="0 0 -9.81"/>
    <statistic center="0 0 0.75" extent="1.5"/>

    <visual>
        <global azimuth="135" elevation="-25"/>
        <headlight diffuse="0.4 0.4 0.4" ambient="0.3 0.3 0.3" specular="0.1 0.1 0.1"/>
        <quality shadowsize="4096" offsamples="8"/>
    </visual>

    <worldbody>

        <light name="key_light" pos="0.6 -0.6 1.6" dir="-0.4 0.4 -1" directional="false"
               diffuse="0.8 0.8 0.75" specular="0.3 0.3 0.3" castshadow="true"/>
        <light name="fill_light" pos="-0.5 0.5 1.3" dir="0.35 -0.35 -1" directional="false"
               diffuse="0.35 0.35 0.4" specular="0 0 0" castshadow="false"/>

        <!-- Fixed, always-static pose, straight down (normal to the table,
             no zaxis/quat needed - that's the default camera orientation).
             pos_z = table-ish working height (0.825) + ~0.82m distance,
             same working distance as before so the banana's apparent size
             doesn't shrink just from the framing change. -->
        <camera name="overhead"
                pos="0 0 1.65"
                fovy="58"/>

        <geom name="ground"
              type="plane"
              size="5 5 0.1"
              rgba="0.8 0.8 0.8 1"/>

    </worldbody>

    <!-- Reusable assets -->
    <include file="../assets/table.xml"/>
    <include file="../assets/tennis_ball/object.xml"/>
    <include file ="../assets/rebot-arm/mjcf/rebot-arm.xml"/>

</mujoco>