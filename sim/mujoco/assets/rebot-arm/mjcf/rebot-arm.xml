                      <geom name="finger_right_mid_collision" type="mesh" mesh="finger_right_mid_collision_mesh" rgba="0.18 0.22 0.21 0.20" contype="1" conaffinity="1" condim="6" margin="0.00015" mass="0.003" friction="1.5 0.04 0.01" solref="0.002 1" solimp="0.98 0.995 0.0005"/>
