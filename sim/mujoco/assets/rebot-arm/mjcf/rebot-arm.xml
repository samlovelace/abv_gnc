  <!-- Named class, not the bare top-level default: <default> (like
       <compiler>) is global across the WHOLE compiled model, not scoped to
       this file - an unnamed default here was silently setting
       contype="0" conaffinity="0" on every geom in the entire scene that
       doesn't set its own, including table.xml's tabletop and even the
       world's own ground plane (confirmed empirically: dropped objects
       fell straight through both). Scoping it to a class and applying that
       class via childclass on base_link below keeps it confined to this
       arm's own geoms, same fix shape as the meshdir issue above. -->
  <default>
    <default class="rebot_arm">
      <joint damping="0.8" armature="0.01" limited="true"/>
      <geom contype="0" conaffinity="0" friction="0.8 0.1 0.1"/>
    </default>
  </default>

