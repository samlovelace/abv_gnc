  <contact>
    <!-- Every directly-jointed pair below shares a seam at the joint axis
         where their convex collision hulls touch/overlap slightly by
         construction - MuJoCo does NOT auto-exclude parent/child body pairs
         (confirmed empirically: base_link vs link1 registers a contact at
         rest without this), so each needs an explicit exclude the same way
         the finger pair already did. This only suppresses the at-the-joint
         seam, not genuine self-collision between non-adjacent links (e.g.
         the end effector folding back into link2/link3), which still goes
         through contact resolution normally. -->
    <exclude body1="base_link" body2="link1"/>
    <exclude body1="link1" body2="link2"/>
    <exclude body1="link2" body2="link3"/>
    <exclude body1="link3" body2="link4"/>
    <exclude body1="link4" body2="link5"/>
    <exclude body1="link5" body2="link6"/>
    <exclude body1="link6" body2="end_link"/>

    <!-- Adjacent convex pieces share X-cut planes.  Excluding contact between
         the two finger bodies prevents those internal seams from friction-locking
         the gripper while preserving finger-to-object contacts. -->
    <exclude body1="finger_left_link" body2="finger_right_link"/>
  </contact>

  <!-- Position-servo actuators, one per joint, named "{joint}_act" - this is
       the naming convention ArmControl (sim/mujoco/sim_modules.py) looks up
       by. Without these, nothing can drive the arm at all: the joints
       existed but had no actuation, so data.ctrl had nothing to write to.
       kp/kv tuned loosely to hold each link's own weight without sagging or
       oscillating (link2 is the heaviest at ~1.3kg), not precision-tuned
       control theory. ctrlrange mirrors each joint's own range so a bad
       commanded goal can't be driven past the physical limit. -->
  <actuator>
    <position joint="joint1" name="joint1_act" kp="200" kv="20" ctrlrange="-2.8 2.8"/>
    <position joint="joint2" name="joint2_act" kp="200" kv="20" ctrlrange="-3.14 0"/>
    <position joint="joint3" name="joint3_act" kp="200" kv="20" ctrlrange="-3.14 0"/>
    <position joint="joint4" name="joint4_act" kp="200" kv="20" ctrlrange="-1.87 1.57"/>
    <position joint="joint5" name="joint5_act" kp="150" kv="15" ctrlrange="-1.57 1.57"/>
    <position joint="joint6" name="joint6_act" kp="100" kv="10" ctrlrange="-3.14 3.14"/>
    <position joint="finger_left" name="finger_left_act" kp="50" kv="5" ctrlrange="0 0.05"/>
    <position joint="finger_right" name="finger_right_act" kp="50" kv="5" ctrlrange="-0.05 0"/>
  </actuator>
</mujoco>
