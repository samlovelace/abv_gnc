<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>autobot_camera_tf</name>
  <version>0.0.0</version>
  <description>broadcasts the fixed camera-to-world static transform, read from config, so downstream perception nodes can express object observations in a stable world frame</description>
  <maintainer email="samlovelace12@gmail.com">sam</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <depend>rclcpp</depend>
  <depend>tf2_ros</depend>
  <depend>geometry_msgs</depend>
  <depend>autobot_common</depend>
  <depend>autobot_config</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
