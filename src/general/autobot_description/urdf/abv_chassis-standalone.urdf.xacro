<?xml version="1.0" ?>
<robot
    xmlns:xacro="http://www.ros.org/wiki/xacro"
    name="autobot_chassis_standalone"
>

  <xacro:include
        filename="$(find autobot_description)/urdf/autobot_chassis.urdf.xacro"
    />

  <!-- Dummy root link — acts as the tree root for RobotModel -->
  <link name="world" />

  <xacro:autobot_chassis parent="world">
    <origin xyz="0 0 0" rpy="0 0 0" />
  </xacro:autobot_chassis>

</robot>
